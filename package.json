{
  "name": "wireguard-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --fix --deny-warnings",
    "lint:check": "oxlint --deny-warnings",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format-check": "pnpm format:check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "pnpm lint:check && pnpm format:check && pnpm typecheck && pnpm test",
    "smoke:deployment": "node --env-file-if-exists=.env.smoke.local scripts/smoke-deployment.ts",
    "firewall:configure": "node scripts/configure-firewall.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.58.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
